{
  "name": "atelier",
  "version": "0.1.2",
  "private": true,
  "description": "Open-source AI design studio. Let Claude Code, Codex or any API-key model design real UI on a canvas.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node tests/e2e/shell-smoke.mjs && node tests/e2e/canvas.mjs && node tests/e2e/panels.mjs && node --import tsx tests/e2e/persistence.mjs && node tests/e2e/mcp-live.mjs && node tests/e2e/toolkit.mjs && node tests/e2e/annotations.mjs",
    "test:e2e:panels": "node tests/e2e/panels.mjs",
    "test:e2e:persist": "node --import tsx tests/e2e/persistence.mjs",
    "test:e2e:mcp": "node tests/e2e/mcp-live.mjs",
    "test:e2e:toolkit": "node tests/e2e/toolkit.mjs",
    "test:e2e:notes": "node tests/e2e/annotations.mjs",
    "promo": "node scripts/render-promo.mjs",
    "demo:core": "tsx scripts/demo-core.ts",
    "probe:css": "tsx scripts/css-probe.ts",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:visual": "node tests/e2e/visual.mjs",
    "test:perf": "node tests/e2e/perf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
