{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities. Minimal on purpose (docs/18): the app's own confined file commands and nothing else. No shell, no fs plugin, no opener, no dialog yet.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-atelier-home",
    "allow-fs-read",
    "allow-fs-read-head",
    "allow-fs-write",
    "allow-fs-write-doc",
    "allow-fs-list",
    "allow-fs-remove",
    "allow-fs-stat",
    "allow-app-state-set",
    "allow-bridge-resync",
    "allow-app-quit"
  ]
}
