{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities. Minimal on purpose (docs/18): the app's own confined file commands and nothing else. No shell, no fs plugin, no opener. The folder dialog for exports is opened from Rust only; the page gets no dialog permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-aframe-home",
    "allow-fs-read",
    "allow-fs-read-head",
    "allow-fs-write",
    "allow-fs-write-doc",
    "allow-fs-list",
    "allow-fs-remove",
    "allow-fs-stat",
    "allow-app-state-set",
    "allow-bridge-resync",
    "allow-app-quit",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-window-start-drag",
    "allow-export-folder",
    "allow-export-pick-folder",
    "allow-export-files",
    "allow-ai-key-status",
    "allow-ai-key-set",
    "allow-ai-key-clear",
    "allow-ai-send",
    "allow-figma-get",
    "allow-figma-download"
  ]
}
